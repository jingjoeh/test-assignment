# Copy to .env (git-ignored) and fill in: cp .env.example .env
# docker compose reads .env; MONGO_URI and PORT are set by docker-compose.yml.

MONGO_DB=user_management
JWT_ISSUER=user-management
JWT_TTL=1h

# At least 32 bytes. Generate one with: openssl rand -base64 32
# This placeholder is deliberately too short, so the API refuses to start
# until it is replaced with a real secret.
JWT_SECRET=replace-me

# Host port for the API (optional, default 8080).
# API_PORT=8080
